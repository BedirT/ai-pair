{
  "name": "ai-pair",
  "displayName": "AI Pair",
  "description": "Pair program with an AI agent: a second cursor that types at a human pace and narrates what it's doing.",
  "version": "0.1.0",
  "publisher": "michalstrba",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1F1F1F",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:integration": "sh scripts/integration.sh",
    "package": "node scripts/build.mjs --production && vsce package --no-dependencies --out ../.."
  },
  "dependencies": {
    "@ai-pair/core": "*",
    "@ai-pair/protocol": "*",
    "jsonc-parser": "^3.3.1"
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "aiPair.pair",
        "label": "AI Pair"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "aiPair",
          "title": "Pair",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "aiPair": [
        {
          "type": "webview",
          "id": "aiPair.narration",
          "name": "Pair"
        }
      ]
    },
    "commands": [
      {
        "command": "aiPair.setUpAgent",
        "title": "Set Up Agent",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.startOmp",
        "title": "Start OMP",
        "category": "AI Pair",
        "icon": "$(play)"
      },
      {
        "command": "aiPair.stopOmp",
        "title": "Stop OMP",
        "category": "AI Pair",
        "icon": "$(debug-stop)"
      },
      {
        "command": "aiPair.abortOmp",
        "title": "Interrupt OMP",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.newOmpChat",
        "title": "New OMP Chat",
        "category": "AI Pair",
        "icon": "$(add)"
      },
      {
        "command": "aiPair.selectOmpModel",
        "title": "Select OMP Model",
        "category": "AI Pair",
        "icon": "$(chevron-down)"
      },
      {
        "command": "aiPair.toggleVoice",
        "title": "Toggle Voice",
        "category": "AI Pair",
        "icon": "$(unmute)"
      },
      {
        "command": "aiPair.selectVoice",
        "title": "Select Voice",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.playDemo",
        "title": "Play Demo Session",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.togglePause",
        "title": "Pause / Resume",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.interrupt",
        "title": "Interrupt",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.toggleTurn",
        "title": "Take / Hand Back the Turn",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.endSession",
        "title": "End Session",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.focusReply",
        "title": "Reply to the Agent",
        "category": "AI Pair"
      },
      {
        "command": "aiPair.askAboutSelection",
        "title": "Ask the Agent About the Selection",
        "category": "AI Pair"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "aiPair.askAboutSelection",
          "when": "aiPair.active && editorHasSelection",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "aiPair.askAboutSelection",
          "when": "aiPair.active && editorHasSelection"
        },
        {
          "command": "aiPair.startOmp",
          "when": "!aiPair.ompActive"
        },
        {
          "command": "aiPair.stopOmp",
          "when": "aiPair.ompActive"
        },
        {
          "command": "aiPair.abortOmp",
          "when": "aiPair.ompActive"
        },
        {
          "command": "aiPair.newOmpChat",
          "when": "aiPair.ompActive"
        },
        {
          "command": "aiPair.selectOmpModel",
          "when": "aiPair.ompActive"
        }
      ],
      "view/title": [
        {
          "command": "aiPair.startOmp",
          "when": "view == aiPair.narration && !aiPair.ompActive",
          "group": "navigation@1"
        },
        {
          "command": "aiPair.newOmpChat",
          "when": "view == aiPair.narration && aiPair.ompActive",
          "group": "navigation@1"
        },
        {
          "command": "aiPair.selectOmpModel",
          "when": "view == aiPair.narration && aiPair.ompActive",
          "group": "navigation@2"
        },
        {
          "command": "aiPair.stopOmp",
          "when": "view == aiPair.narration && aiPair.ompActive",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "AI Pair",
      "properties": {
        "aiPair.speed": {
          "type": "number",
          "default": 1,
          "minimum": 0.25,
          "maximum": 4,
          "description": "Overall playback speed: typing, pauses, and reading time. The panel's speed menu offers 0.4× to 3×."
        },
        "aiPair.agentName": {
          "type": "string",
          "default": "Agent",
          "description": "Name shown on the agent's cursor."
        },
        "aiPair.timing": {
          "type": "object",
          "default": {},
          "markdownDescription": "Calibration: override any playback timing, in milliseconds at normal speed. See `packages/core/src/timing.ts` for every key and its default, e.g. `{ \"afterSelectMs\": 900, \"type\": { \"wordStartMs\": 140 } }`."
        },
        "aiPair.confirmCommands": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Ask in the Pair panel before running each command the agent plays in the terminal (`run`). Turning this off lets the agent run commands without its own permission prompt."
        },
        "aiPair.omp.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the omp program the Pair panel starts. Empty finds omp on the PATH, in ~/.local/bin, or in ~/.bun/bin."
        },
        "aiPair.omp.model": {
          "type": "string",
          "default": "",
          "description": "Model the panel's OMP starts with (OMP's fuzzy match, like opus or openai/gpt-5.2). Empty uses OMP's own default. The panel's Model button changes it for the chat."
        },
        "aiPair.voice.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Hear the agent instead of reading it: each thing it says is spoken on this machine (Kokoro, the local speech model OMP ships; the first turn-on may download it, about 100 MB of model in a few hundred MB of runtime). The words still land in the panel's history. The words are spread over the typing they explain, so talking and typing run together."
        },
        "aiPair.voice.voice": {
          "type": "string",
          "default": "af_heart",
          "enum": ["af_heart", "af_bella", "af_nicole", "af_aoede", "af_kore", "af_sarah", "am_michael", "am_fenrir", "am_puck", "bf_emma", "bm_george", "bm_fable"],
          "description": "Whose Kokoro voice the agent speaks with. The panel's Pick a voice changes it."
        },
        "aiPair.voice.rate": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 2,
          "description": "How fast the voice talks: 1 is its own pace."
        },
        "aiPair.voice.runtimePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to a bun or node program to run the voice process with (VS Code's own runtime cannot load the speech engine). Empty finds bun, then node, in the usual places."
        }
      }
    },
    "colors": [
      {
        "id": "aiPair.cursor",
        "description": "The agent's cursor.",
        "defaults": {
          "dark": "#E8875B",
          "light": "#C2410C",
          "highContrast": "#FF9E6B",
          "highContrastLight": "#9A3412"
        }
      },
      {
        "id": "aiPair.cursorRead",
        "description": "The agent's cursor while it waits for you to read its message.",
        "defaults": {
          "dark": "#FACC15",
          "light": "#B7791F",
          "highContrast": "#FFE14D",
          "highContrastLight": "#7A5C00"
        }
      },
      {
        "id": "aiPair.cursorForeground",
        "description": "Text on the agent cursor's name label.",
        "defaults": {
          "dark": "#1B1B1B",
          "light": "#FFFFFF",
          "highContrast": "#000000",
          "highContrastLight": "#FFFFFF"
        }
      },
      {
        "id": "aiPair.cursorReadForeground",
        "description": "Text on the agent cursor's name label while it waits for you to read its message.",
        "defaults": {
          "dark": "#1B1B1B",
          "light": "#1B1B1B",
          "highContrast": "#000000",
          "highContrastLight": "#FFFFFF"
        }
      },
      {
        "id": "aiPair.selectionBackground",
        "description": "Background of the agent's selection.",
        "defaults": {
          "dark": "#E8875B40",
          "light": "#C2410C2E",
          "highContrast": "#FF9E6B55",
          "highContrastLight": "#9A341240"
        }
      },
      {
        "id": "aiPair.pointBackground",
        "description": "Background of code the agent is pointing at.",
        "defaults": {
          "dark": "#FACC1526",
          "light": "#B7791F20",
          "highContrast": "#FFE14D40",
          "highContrastLight": "#7A5C0030"
        }
      },
      {
        "id": "aiPair.pointBorder",
        "description": "Border of code the agent is pointing at.",
        "defaults": {
          "dark": "#FACC1599",
          "light": "#B7791F99",
          "highContrast": "#FFE14D",
          "highContrastLight": "#7A5C00"
        }
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "1.105.0",
    "@vscode/vsce": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/faiface/ai-pair.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/faiface/ai-pair#readme",
  "bugs": {
    "url": "https://github.com/faiface/ai-pair/issues"
  }
}
